#!/usr/bin/env python3
"""Copy out the part of local/ that a built image actually runs on.

The staged tree is ~255 MB, nearly all of it there to *build* decoding
graphs: Kaldi's binaries and egs scripts, OpenFST, the lexicon, the
training FSTs. An image that ships its graphs ready-made needs none of it.

What is left is the resident decoder's own dependencies -- the shared
libraries it links, and the four kinds of file it opens -- found by asking
the binary and the generated online config rather than by listing them
here, so this does not quietly go stale when either changes.

    script/prune_runtime <staged local/> <destination>
"""

import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

DAEMON = Path("voice/kaldi/decoderd/verify_decoderd")


def linked_libraries(binary: Path, tools: Path) -> set[Path]:
    """The libraries ldd resolves inside the staged tree."""
    out = subprocess.run(
        ["ldd", str(binary)], capture_output=True, text=True, check=True
    ).stdout
    found = set()
    for line in out.splitlines():
        match = re.search(r"=>\s+(\S+)", line)
        if match:
            path = Path(match.group(1)).resolve()
            if tools.resolve() in path.parents:
                found.add(path)
    return found


RUNTIME_MODEL_PATHS = (
    "lexicon.db",
    "model/phones",
    "model/online/conf",
    "model/online/ivector_extractor",
    "model/model/final.mdl",
)
"""What a model needs once its graphs are built.

Spelled out rather than read off the generated config, which names its
files by absolute path and so says nothing useful about a tree that has
not been prepared yet. ``lexicon.db`` is here because every wake word's
pronunciation is checked against it on every start, not only when graphs
are built; the rest is what the decoder opens.

Left behind: Kaldi's binaries and egs scripts, OpenFST, and the training
FSTs beside final.mdl (den, normalization, tree) -- along with the second
copy of final.mdl and final.ie that the tree carries under model/online
and model/extractor.
"""


def model_files(models: Path) -> set[Path]:
    """The runtime part of every staged model."""
    found = set()
    for model_dir in sorted(models.iterdir()):
        if not model_dir.is_dir():
            continue
        for relative in RUNTIME_MODEL_PATHS:
            path = model_dir / relative
            if path.is_file():
                found.add(path.resolve())
            elif path.is_dir():
                found.update(
                    child.resolve() for child in path.rglob("*") if child.is_file()
                )
    return found


def main() -> None:
    staged, dest = (Path(a).absolute() for a in sys.argv[1:3])
    tools, models = staged / "wake-kaldi-tools", staged / "wake-kaldi-models"

    wanted = linked_libraries(DAEMON.absolute(), tools)
    wanted |= model_files(models)
    if not wanted:
        sys.exit("Nothing to prune: is the decoder daemon built?")

    # Where each real file sits inside the staged tree, which is not the
    # same thing during development: local/ is symlinked to a checkout there.
    logical: dict[Path, Path] = {}
    for root, _dirs, files in os.walk(staged, followlinks=True):
        for name in files:
            path = Path(root) / name
            logical.setdefault(path.resolve(), path)

    kept = 0
    for path in sorted(wanted):
        target = dest / logical.get(path, path).relative_to(staged)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, target)
        kept += target.stat().st_size

    # Debug symbols are a quarter of the libraries and nothing reads them.
    stripped = 0
    for lib in sorted(dest.rglob("*.so*")):
        before = lib.stat().st_size
        try:
            done = subprocess.run(["strip", "--strip-unneeded", str(lib)])
        except FileNotFoundError:
            print("No strip here; keeping the symbols")
            break
        if done.returncode == 0:
            stripped += before - lib.stat().st_size
    if stripped:
        kept -= stripped
        print(f"Stripped {stripped / 1048576:.0f} MB of symbols")

    staged_size = sum(p.stat().st_size for p in logical.values())
    print(
        f"Kept {len(wanted)} files, {kept / 1048576:.0f} MB "
        f"of {staged_size / 1048576:.0f} MB"
    )


main()
