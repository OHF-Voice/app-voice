#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Start the Voice app: wake word verification over HTTP/websocket on :10800.
# ==============================================================================
cd /usr/src/voice || exit 1

# Everything else is already right: wake.yaml sits beside the app and says
# where its graphs are, and the image built them there.
exec python3 -m voice \
    --host '0.0.0.0' \
    --port 10800
